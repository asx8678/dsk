{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/dsk.py\" configure --hook --announce --data \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/dsk.py\" configure --hook --data \"${CLAUDE_PLUGIN_DATA}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/dsk.py\" status --hook"
          }
        ]
      }
    ]
  }
}
